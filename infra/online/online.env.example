# Template only: create the real file outside the checkout, readable only by its service owner.
NODE_ENV=production
ONLINE_DATABASE_URL=postgresql://REPLACE_ROLE:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:REPLACE_DB_PORT/REPLACE_DATABASE
BOT_TOKEN=REPLACE_FROM_PROTECTED_CONFIGURATION
ONLINE_ORIGIN=https://example.invalid
# Bind only the dedicated interface reachable by project Caddy; root verifies routing/firewall.
ONLINE_HOST=REPLACE_PRIVATE_BIND_ADDRESS
ONLINE_PORT=REPLACE_FREE_API_PORT
API_BASE_PATH=/r2/api/online
# Integration #18/#20: API, poller and workers share one main.ts process.
ONLINE_BOT_USERNAME=REPLACE_WITHOUT_AT
ONLINE_CHAT_ID=REPLACE_NEGATIVE_NUMERIC_CHAT_ID
ONLINE_THREAD_ID=REPLACE_POSITIVE_TOPIC_ID
ONLINE_WEBAPP_URL=https://example.invalid/r2/
# Exact project Caddy peer IPs as seen by API, comma-separated; no CIDR/hostnames.
# Empty means no trusted proxy. This is NOT the shared-gateway peer from Caddy config.
ONLINE_TRUSTED_PROXY_IPS=REPLACE_EXACT_PROJECT_CADDY_PEER_IPS
