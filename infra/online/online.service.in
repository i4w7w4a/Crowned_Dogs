[Unit]
Description=Crowned Dogs online runtime
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@ONLINE_USER@
Group=@ONLINE_GROUP@
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@ONLINE_ENV_FILE@
# Build WASM and run migrations explicitly before starting this service.
ExecStart=@NODE_EXECUTABLE@ apps/server/src/online/main.ts
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
