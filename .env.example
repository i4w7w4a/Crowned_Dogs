# Токен бота от @BotFather. Скопируй этот файл в .env и впиши свой токен.
BOT_TOKEN=

# Где хранить подписанные контракты и жетоны игроков. Можно не трогать.
# OPERATORS_FILE=data/operators.json

# Отдельный online API. Значения задаются локально; строку БД и BOT_TOKEN не публиковать.
ONLINE_DATABASE_URL=
ONLINE_ORIGIN=
# ONLINE_HOST=127.0.0.1
# ONLINE_PORT=3100
# API_BASE_PATH=/api/online
# Для существующего сайта: API_BASE_PATH=/r2/api/online
# В production обязательно NODE_ENV=production и HTTPS (Secure cookie).
# NODE_ENV=production

# Только для ручного native PostgreSQL теста: отдельная локальная crowned_dogs_test БД.
# ONLINE_TEST_DATABASE_URL=
