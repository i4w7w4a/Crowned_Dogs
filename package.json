{
  "name": "crowned-dogs",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "bot": "node --env-file-if-exists=.env apps/server/src/main.ts",
    "balance": "node packages/core/scripts/balance.ts",
    "web": "npm run dev -w @crowned-dogs/web",
    "web:build": "npm run build -w @crowned-dogs/web",
    "kits": "node packages/core/scripts/kits.ts",
    "icons": "node packages/icons/scripts/build.ts",
    "rust:build": "node tools/rust-build.mjs wasm",
    "rust:check": "node tools/rust-build.mjs check",
    "local:build": "node tools/rust-build.mjs local",
    "precheck": "npm run rust:build",
    "preweb:build": "npm run rust:build",
    "preweb": "npm run rust:build",
    "pretest": "npm run rust:build",
    "pretypecheck": "npm run rust:build",
    "prebot": "npm run rust:build",
    "prebalance": "npm run rust:build",
    "prekits": "npm run rust:build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
