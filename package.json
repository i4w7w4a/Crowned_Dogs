{
  "name": "crowned-dogs",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "bot": "node --env-file-if-exists=.env apps/server/src/main.ts",
    "balance": "node packages/core/scripts/balance.ts",
    "kits": "node packages/core/scripts/kits.ts",
    "icons": "node packages/icons/scripts/build.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
